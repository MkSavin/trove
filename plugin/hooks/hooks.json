{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "trove", "args": ["hook", "post-edit"], "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "trove", "args": ["hook", "stop"], "timeout": 120 }
        ]
      }
    ]
  }
}
